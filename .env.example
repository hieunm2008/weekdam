# Public Firebase web app configuration. Never put service-account keys here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Pro development defaults to the isolated local Emulator project.
VITE_USE_FIREBASE_EMULATORS=true
# Cloud Pro demo ONLY: set true after creating a separate sandbox Web app.
# Never use weekdam-hieu-2026. See docs/pro-firebase-sandbox.md.
VITE_FIREBASE_PRO_SANDBOX=false
